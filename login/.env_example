# Application configuration
# This file is mainly for direct local app runs or local Docker fallback.
# For Docker production, prefer the root .env.production flow instead.
# APP_ENV=local  -> automatic Local Admin login, no Auth0 redirect
# APP_ENV=production -> Auth0 login enabled and SECRET_KEY required
APP_PORT=3000
APP_ENV=local
SECRET_KEY=change-me-before-production
CRAWLA_STUDIO_ENABLED=true

# Auth0 configuration (staging / production only)
# Use a Regular Web Application in Auth0.
# AUTH0_CALLBACK_URL must exactly match the Auth0 Allowed Callback URL.
# AUTH0_LOGOUT_REDIRECT_URL must exactly match the Auth0 Allowed Logout URL.
AUTH0_CLIENT_ID=
AUTH0_DOMAIN=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=
AUTH0_LOGOUT_REDIRECT_URL=
AUTH0_AUDIENCE=

# Google Gemini API key (optional)
# Prefer this env var for local Docker runs.
# Production can also use GOOGLE_API_KEY_FILE in the root .env.production template.
GOOGLE_API_KEY=

# Optional Gemini tuning
# CRAWLA_GEMINI_MODEL=gemini-2.5-flash-preview-04-17
# CRAWLA_GEMINI_TEMPERATURE=0.7
# CRAWLA_GEMINI_MAX_OUTPUT_TOKENS=512
# CRAWLA_GEMINI_THINKING_LEVEL=MINIMAL