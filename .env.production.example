# Copy this file to .env.production and start the stack with:
# docker compose --env-file .env.production -f docker-compose.production.yml up -d --build

APP_PORT=3000
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
CRAWLA_WEB_SERVER=gunicorn

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
# GUNICORN_WORKER_CLASS=gthread
CRAWLA_ENABLE_APP_HSTS=false

CRAWLA_STUDIO_ENABLED=true
CRAWLA_STUDIO_INSPECTOR_ENABLED=true
CRAWLA_STUDIO_COPILOT_ENABLED=true
CRAWLA_STUDIO_DEBUGGER_ENABLED=false
CRAWLA_SELENIUM_IMAGE=selenium/standalone-chrome:131.0
# On ARM64 hosts, override to selenium/standalone-chromium:131.0.

# Auth0
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CALLBACK_URL=https://crawla.example.com/callback
AUTH0_LOGOUT_REDIRECT_URL=https://crawla.example.com/
AUTH0_AUDIENCE=

# MongoDB
# Keep local defaults or point to Atlas / a managed cluster.
CRAWLA_MONGO_MODE=local
CRAWLA_MONGO_DB=crawla
CRAWLA_MONGO_URI=
CRAWLA_ATLAS_HOST=
CRAWLA_ATLAS_DB=
CRAWLA_ATLAS_USER=
CRAWLA_ATLAS_PASSWORD=
CRAWLA_ATLAS_PASSWORD_FILE=

# Redis / Celery
CRAWLA_REDIS_HOST_PORT=local
CRAWLA_REDIS_URL=
CRAWLA_REDIS_PASSWORD=
CRAWLA_REDIS_PASSWORD_FILE=

# Email notifications
CRAWLA_HOST_URL=crawla.example.com
CRAWLA_MAIL_HOST=
CRAWLA_MAIL_PORT=465
CRAWLA_MAIL_SENDER=
CRAWLA_MAIL_USER=
CRAWLA_MAIL_PASSWORD=
CRAWLA_MAIL_PASSWORD_FILE=

# Gemini
GOOGLE_API_KEY=
GOOGLE_API_KEY_FILE=
CRAWLA_GEMINI_MODEL=gemini-2.5-flash-preview-04-17
CRAWLA_GEMINI_TEMPERATURE=0.7
CRAWLA_GEMINI_MAX_OUTPUT_TOKENS=512
CRAWLA_GEMINI_THINKING_LEVEL=MINIMAL